{
  "name": "dsh-file-enhance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 文件规范插件：按 .dsh/folder-path-rules/<ext>.yaml 约束 agent 新建文件（MVP 只管 .md）的落点与命名",
  "license": "MIT",
  "author": "kakaCat <253834671@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaCat/dsh-file-enhance.git"
  },
  "bugs": {
    "url": "https://github.com/kakaCat/dsh-file-enhance/issues"
  },
  "homepage": "https://github.com/kakaCat/dsh-file-enhance#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "agent",
    "file-management",
    "documentation",
    "markdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "sync:specs": "node scripts/sync-builtin-specs.mjs",
    "prebuild": "pnpm sync:specs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-alpha.2"
  }
}
